# Large build artifacts
*.img
*.raw
*.zip
*.lz4

# Except stock files
!stock-files/*.img
!stock-files/*.lz4

# Except TEE files
!tee-files/**/*.ta
!tee-files/**/*.so
!tee-files/**/*.rc
!tee-files/**/*.xml
!tee-files/bin/*
!tee-files/bin-hw/*

# Backup files
*.backup
*.bak
main.yml.backup

# Python cache
__pycache__/
*.pyc
*.pyo
