import /init.recovery.project.rc

on init
    setprop sys.usb.configfs 1
    setprop sys.usb.controller "11201000.usb0"
    insmod /vendor/lib/modules/focaltech_tp.ko
    mkdir /mnt/twrp_t6 0770 system system
    mkdir /mnt/twrp_t6/fs 0770 system system
    mkdir /mnt/twrp_t6/app 0770 system system
    mkdir /mnt/twrp_t6/persist 0770 system system
    mkdir /mnt/twrp_t6/protect 0770 system system
    mkdir /mnt/twrp_t6/log 0770 system system
    setprop vendor.trustkernel.fs.mode 3
    setprop vendor.trustkernel.fs.state ready
    setprop vendor.trustkernel.log.state ready

on fs && property:ro.debuggable=0
    # USB charging handling

on boot
    exec u:r:update_engine:s0 root root -- /system/bin/mtk_plpath_utils
    start adbd
    start teed

service teed /vendor/bin/teed \
    --tzdev /dev/tkcore_admin \
    --datapath /mnt/twrp_t6/fs \
    --sptapath /mnt/twrp_t6/app \
    --systapath /vendor/app/t6 \
    --rpmbdev /dev/mmcblk0rpmb \
    --rpmbdev /dev/rpmb0 \
    --prot /mnt/twrp_t6/persist \
    --prot /mnt/twrp_t6/protect \
    --prebuilt /vendor/app/t6/data \
    --logpath /mnt/twrp_t6/log/tkcore.log \
    --proprefix vendor.trustkernel
        capabilities SYS_RAWIO
        user system
        group system
        class core
        disabled

service vendor.keymint-3-0-trustkernel /vendor/bin/hw/android.hardware.security.keymint@3.0-service.trustkernel
        class early_hal
        user system
        group system
        disabled

service vendor.gatekeeper /vendor/bin/hw/android.hardware.gatekeeper-service.trustkernel
        class hal
        user system
        group system
        disabled

on property:init.svc.teed=running
    start vendor.keymint-3-0-trustkernel
    start vendor.gatekeeper
